  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run react-router dev",
      "runtimeExecutable": "bun",
      "cwd": "${workspaceFolder}",
      "args": ["run", "dev"]
    },

    {
      "type": "node",
      "request": "launch",
      "name": "Run cloudflare miniflare",
      "runtimeExecutable": "bun",
      "cwd": "${workspaceFolder}",
      "args": ["run", "cf-dev"]
    },

    {
      "type": "node",
      "request": "launch",
      "name": "Run build",
      "runtimeExecutable": "bun",
      "cwd": "${workspaceFolder}",
      "args": ["run", "build"]
    }
  ]
}
